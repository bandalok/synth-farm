# Copy to .env and tune. Every variable is optional — defaults work out of the box.
# (The farm never needs API keys; there is nothing secret here. .env is for
# tuning knobs, and .gitignore keeps local outputs out of version control.)

# --- population ---
SF_N_PERSONAS=300
SF_SEED=42
SF_SIM_DAYS=7
SF_CATALOG_SIZE=800
# SF_GENRES=action,comedy,drama,horror,scifi,documentary,romance,thriller,animation,crime,fantasy,reality

# --- click model (position bias lives here) ---
SF_POSITION_BIAS_DECAY=0.85
SF_CLICK_TEMPERATURE=1.0

# --- session engine ---
SF_EVENING_PEAK_HOUR=21.0
SF_EVENING_PEAK_WIDTH=2.5
SF_LUNCH_PEAK_HOUR=12.5
SF_LUNCH_PEAK_WEIGHT=0.45
SF_NIGHT_FLOOR=0.05
SF_WEEKEND_BOOST=1.6
SF_SLATE_SIZE=12
SF_SEARCH_RESULT_LIMIT=10
SF_MAX_UNITS_PER_SESSION=3
SF_TYPO_PROBABILITY=0.06

# --- farm runner ---
SF_MAX_INFLIGHT=256
SF_AGENT_JITTER_MAX_S=0.0
SF_PROGRESS_EVERY=5000

# --- training ---
SF_ALS_FACTORS=24
SF_ALS_ITERATIONS=12
SF_ALS_REG=0.08
SF_ALS_ALPHA=8.0
SF_TRAIN_FRACTION=0.8
SF_EVAL_TOP_K=20

# --- outputs ---
SF_EVENTS_PATH=events.jsonl
SF_DB_PATH=synth_farm.db
